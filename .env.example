# CEREBRO Research Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ── Frontend ───────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5000

# ── OpenAI (Optional) ─────────────────────────────────────────────────────────
# Without this key the agent uses keyword-based extraction (no hallucination risk).
# Set this to enable full GPT-powered cited synthesis.
OPENAI_API_KEY=your-openai-api-key-here

# Model to use. gpt-3.5-turbo is fast and cheap; gpt-4o is more capable.
LLM_MODEL=gpt-3.5-turbo

# ── Retrieval Settings ─────────────────────────────────────────────────────────
# Number of passages to retrieve per query
SEARCH_TOP_K=5

# Minimum combined relevance score to include a passage (0.0 - 1.0)
# Passages below this threshold are excluded from the LLM context.
# Raise this (e.g. 0.45) to reduce noise; lower it (e.g. 0.20) to be more permissive.
MIN_SIMILARITY_SCORE=0.30

# Weight for semantic score vs BM25 score (0.0 = BM25-only, 1.0 = semantic-only)
SEMANTIC_WEIGHT=0.60

# Embedding model (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/cerebro.log

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string-in-production

# ── Document Settings ──────────────────────────────────────────────────────────
MAX_DOCUMENT_SIZE=10485760
ALLOWED_DOCUMENT_TYPES=pdf,txt,docx,md
